@page
@model ArcaneVault.Web.Pages.CollectionItems.IndexModel
@{
    ViewData["Title"] = "My Collection";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>My Collection</h2>
    <a asp-page="Create" class="btn btn-success">+ Add Item</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@* Search bar — matches any field *@
<form method="get" class="mb-3">
    <div class="input-group">
        <input type="text" name="search" class="form-control"
               placeholder="Search by name, category, username…"
               value="@Model.Search" />
        <button class="btn btn-outline-secondary" type="submit">Search</button>
        @if (!string.IsNullOrWhiteSpace(Model.Search))
        {
            <a asp-page="Index" class="btn btn-outline-danger">Clear</a>
        }
    </div>
</form>

@if (Model.Items.Count == 0)
{
    <p class="text-muted">No items found.</p>
}
else
{
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>#</th>
                <th>Item Name</th>
                <th>Categories</th>
                <th>Starting Qty</th>
                <th>Current Qty</th>
                <th>Owner</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var (item, index) in Model.Items.Select((i, idx) => (i, idx)))
            {
                <tr>
                    <td>@(index + 1)</td>
                    <td>@item.ItemName</td>
                    <td>
                        @if (item.Categories.Any())
                        {
                            @string.Join(", ", item.Categories.Select(c => c.CategoryName))
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </td>
                    <td>@item.StartingQuantity</td>
                    <td>@item.CurrentQuantity</td>
                    <td>@item.UserName</td>
                    <td>
                        <a asp-page="Details" asp-route-id="@item.ItemId"
                           class="btn btn-sm btn-info me-1">Details</a>
                        @* Only owner or Staff can edit/delete *@
                        @if (item.UserName == HttpContext.Session.GetString("UserName")
                             || HttpContext.Session.GetString("RoleName") == "Staff")
                        {
                            <a asp-page="Edit" asp-route-id="@item.ItemId"
                               class="btn btn-sm btn-warning me-1">Edit</a>
                            <a asp-page="Delete" asp-route-id="@item.ItemId"
                               class="btn btn-sm btn-danger">Delete</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
