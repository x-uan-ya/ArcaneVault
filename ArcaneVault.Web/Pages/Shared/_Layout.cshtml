@* Name: Ng Xuan Ya | Admin: 253125M | Tutorial: 04 *@
@{
    // Helper to read session in the layout
    var sess       = ViewContext.HttpContext.Session;
    var loggedUser = sess.GetString("UserName");
    var roleName   = sess.GetString("RoleName");
    bool isLoggedIn = loggedUser != null;
    bool isStaff    = roleName == "Staff";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ArcaneVault</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ArcaneVault.Web.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-dark border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-area="" asp-page="/Index">🗝️ ArcaneVault</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-page="/Index">Home</a>
                        </li>

                        @* Show My Collection when logged in *@
                        @if (isLoggedIn)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-page="/CollectionItems/Index">My Collection</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-page="/Wishlist/Index">Wishlist</a>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-white" href="#" id="marketplaceDropdown" role="button" 
                                   data-bs-toggle="dropdown" aria-expanded="false">
                                    Marketplace
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="marketplaceDropdown">
                                    <li><a class="dropdown-item" asp-page="/Marketplace/Index">Browse Listings</a></li>
                                    <li><a class="dropdown-item" asp-page="/Marketplace/Create">Create Listing</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" asp-page="/Marketplace/MyListings">My Listings</a></li>
                                    <li><a class="dropdown-item" asp-page="/Marketplace/MyOffers">My Offers</a></li>
                                </ul>
                            </li>
                        }

                        @* Categories: Staff only *@
                        @if (isStaff)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-page="/Categories/Index">Categories</a>
                            </li>
                        }
                    </ul>

                    <ul class="navbar-nav">
                        @if (!isLoggedIn)
                        {
                            @* Not logged in: show Login / Register *@
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-page="/Account/Login">Login</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-page="/Account/Register">Register</a>
                            </li>
                        }
                        else
                        {
                            @* Logged in: show username and Logout *@
                            <li class="nav-item">
                                <span class="nav-link text-warning">
                                    👤 @loggedUser (@roleName)
                                </span>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-page="/Account/Logout">Logout</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted mt-4">
        <div class="container py-2">
            &copy; 2026 ArcaneVault &mdash; Ng Xuan Ya
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
