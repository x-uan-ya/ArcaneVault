@page
@model ArcaneVault.Web.Pages.Marketplace.CreateModel
@{
    ViewData["Title"] = "Create Listing";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-lg-8 mx-auto">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0"><i class="bi bi-plus-circle"></i> Create Marketplace Listing</h4>
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="bi bi-exclamation-triangle-fill"></i> @Model.ErrorMessage
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    @if (!Model.MyItems.Any())
                    {
                        <div class="alert alert-warning">
                            <i class="bi bi-info-circle"></i> You don't have any items available to list. 
                            <a asp-page="/CollectionItems/Index" class="alert-link">Add items to your collection first</a>.
                        </div>
                    }
                    else
                    {
                        <form method="post">
                            <div class="mb-3">
                                <label asp-for="ItemId" class="form-label">Select Item <span class="text-danger">*</span></label>
                                <select asp-for="ItemId" class="form-select" required>
                                    <option value="0">-- Select an item --</option>
                                    @foreach (var item in Model.MyItems)
                                    {
                                        <option value="@item.ItemId">
                                            @item.ItemName (Qty: @item.CurrentQuantity)
                                            @if (item.Categories != null && item.Categories.Any())
                                            {
                                                <text> - @string.Join(", ", item.Categories.Select(c => c.CategoryName))</text>
                                            }
                                        </option>
                                    }
                                </select>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Title" class="form-label">Listing Title <small class="text-muted">(optional, defaults to item name)</small></label>
                                <input asp-for="Title" class="form-control" maxlength="200" placeholder="e.g., Rare Magic Card - Mint Condition" />
                            </div>

                            <div class="mb-3">
                                <label asp-for="Description" class="form-label">Description <span class="text-danger">*</span></label>
                                <textarea asp-for="Description" class="form-control" rows="4" maxlength="1000" required
                                          placeholder="Describe the item, its condition, and any relevant details..."></textarea>
                                <small class="text-muted">Maximum 1000 characters</small>
                            </div>

                            <div class="mb-3">
                                <label asp-for="ListingType" class="form-label">Listing Type <span class="text-danger">*</span></label>
                                <select asp-for="ListingType" class="form-select" id="listingTypeSelect" required>
                                    <option value="Sale">Sale</option>
                                    <option value="Trade">Trade</option>
                                    <option value="Both">Sale or Trade</option>
                                </select>
                            </div>

                            <div class="mb-3" id="priceField">
                                <label asp-for="AskingPrice" class="form-label">Asking Price ($) <span class="text-danger">*</span></label>
                                <input asp-for="AskingPrice" type="number" step="0.01" min="0.01" class="form-control" placeholder="0.00" />
                            </div>

                            <div class="mb-3" id="tradeField" style="display: none;">
                                <label asp-for="TradePreferences" class="form-label">Item You Want in Trade <span class="text-danger">*</span></label>
                                <input asp-for="TradePreferences" class="form-control" maxlength="200"
                                          placeholder="e.g., Pikachu" />
                                <small class="text-muted">Enter the exact item name you want to receive in trade (not case sensitive)</small>
                            </div>

                            <div class="mb-3">
                                <label asp-for="QuantityAvailable" class="form-label">Quantity Available <span class="text-danger">*</span></label>
                                <input asp-for="QuantityAvailable" type="number" min="1" class="form-control" required />
                            </div>

                            <div class="mb-3">
                                <label asp-for="ExpirationDays" class="form-label">Expiration Days <small class="text-muted">(optional, listing auto-expires)</small></label>
                                <input asp-for="ExpirationDays" type="number" min="1" max="365" class="form-control" placeholder="e.g., 30" />
                                <small class="text-muted">Leave blank for no expiration</small>
                            </div>

                            <div class="d-grid gap-2">
                                <button type="submit" class="btn btn-primary btn-lg">
                                    <i class="bi bi-check-circle"></i> Create Listing
                                </button>
                                <a asp-page="MyListings" class="btn btn-outline-secondary">
                                    <i class="bi bi-x-circle"></i> Cancel
                                </a>
                            </div>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Show/hide price and trade fields based on listing type
        document.getElementById('listingTypeSelect').addEventListener('change', function() {
            const priceField = document.getElementById('priceField');
            const tradeField = document.getElementById('tradeField');
            const priceInput = priceField.querySelector('input');
            const tradeInput = tradeField.querySelector('textarea');

            if (this.value === 'Sale') {
                priceField.style.display = 'block';
                tradeField.style.display = 'none';
                priceInput.required = true;
                const tradeInput = tradeField.querySelector('input');
                tradeInput.required = false;
            } else if (this.value === 'Trade') {
                priceField.style.display = 'none';
                tradeField.style.display = 'block';
                priceInput.required = false;
                const tradeInput = tradeField.querySelector('input');
                tradeInput.required = true;
            } else { // Both
                priceField.style.display = 'block';
                tradeField.style.display = 'block';
                priceInput.required = true;
                const tradeInput = tradeField.querySelector('input');
                tradeInput.required = true;
            }
        });
    </script>
}
