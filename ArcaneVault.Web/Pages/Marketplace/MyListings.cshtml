@page
@model ArcaneVault.Web.Pages.Marketplace.MyListingsModel
@{
    ViewData["Title"] = "My Listings";
    var pendingOffers = Model.ReceivedOffers.Where(o => o.Status == "Pending").ToList();
}

<style>
    .listing-card { transition: box-shadow .2s, transform .2s; }
    .listing-card:hover { box-shadow: 0 8px 24px rgba(0,0,0,.10) !important; transform: translateY(-2px); }
    .offer-row { transition: background .15s; }
    .offer-row:hover { background: #f8fafc !important; }
    .status-dot { width:8px; height:8px; border-radius:50%; display:inline-block; margin-right:5px; }
</style>

<div class="container mt-4">

    @* Page Header *@
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0"><i class="bi bi-shop-window me-2 text-primary"></i>My Listings</h2>
            <p class="text-muted small mb-0 mt-1">Manage your marketplace listings and incoming offers</p>
        </div>
        <a asp-page="Create" class="btn btn-primary px-4 rounded-pill shadow-sm">
            <i class="bi bi-plus-circle me-1"></i> New Listing
        </a>
    </div>

    @* Alerts *@
    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 border-0 shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@Model.SuccessMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 border-0 shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@Model.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (!string.IsNullOrEmpty(Model.ProcessingMessage))
    {
        <div class="alert alert-warning alert-dismissible fade show rounded-3 border-0 shadow-sm" role="alert">
            <span class="spinner-border spinner-border-sm me-2"></span>@Model.ProcessingMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @* Stats Row *@
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card border-0 rounded-3 shadow-sm text-center py-3">
                <div class="fs-3 fw-bold text-primary">@Model.Listings.Count</div>
                <div class="small text-muted">Total Listings</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 rounded-3 shadow-sm text-center py-3">
                <div class="fs-3 fw-bold text-success">@Model.Listings.Count(l => l.Status == "Active")</div>
                <div class="small text-muted">Active</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 rounded-3 shadow-sm text-center py-3">
                <div class="fs-3 fw-bold text-warning">@pendingOffers.Count</div>
                <div class="small text-muted">Pending Offers</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 rounded-3 shadow-sm text-center py-3">
                <div class="fs-3 fw-bold text-info">@Model.Listings.Sum(l => l.ViewCount)</div>
                <div class="small text-muted">Total Views</div>
            </div>
        </div>
    </div>

    @* My Listings *@
    <div class="card border-0 rounded-4 shadow-sm mb-4">
        <div class="card-header bg-white border-bottom rounded-top-4 px-4 py-3">
            <h5 class="mb-0 fw-semibold"><i class="bi bi-grid-3x3-gap me-2 text-primary"></i>
                Listings <span class="badge bg-primary ms-1">@Model.Listings.Count</span>
            </h5>
        </div>
        <div class="card-body p-4">
            @if (!Model.Listings.Any())
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-inbox" style="font-size:3rem; color:#cbd5e1;"></i>
                    <p class="mt-3 fw-semibold">No listings yet</p>
                    <p class="small mb-3">List an item from your collection to start selling or trading.</p>
                    <a asp-page="Create" class="btn btn-primary rounded-pill px-4">
                        <i class="bi bi-plus-circle me-1"></i> Create First Listing
                    </a>
                </div>
            }
            else
            {
                <div class="row g-3">
                    @foreach (var listing in Model.Listings.OrderByDescending(l => l.ListedDate))
                    {
                        var statusColor = listing.Status switch {
                            "Active"    => ("success", "#dcfce7", "#16a34a"),
                            "Sold"      => ("info",    "#dbeafe", "#1d4ed8"),
                            "Cancelled" => ("secondary","#f1f5f9","#64748b"),
                            _           => ("secondary","#f1f5f9","#64748b")
                        };
                        var typeColor = listing.ListingType switch {
                            "Sale"  => "primary",
                            "Trade" => "warning",
                            "Both"  => "success",
                            _       => "secondary"
                        };
                        <div class="col-12 col-md-6 col-lg-4">
                            <div class="card listing-card border-0 rounded-3 h-100"
                                 style="box-shadow:0 2px 8px rgba(0,0,0,.07);">
                                <div class="card-body p-3">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <span class="badge rounded-pill"
                                              style="background:@statusColor.Item2; color:@statusColor.Item3; font-weight:600;">
                                            @listing.Status
                                        </span>
                                        <span class="badge bg-@typeColor rounded-pill">@listing.ListingType</span>
                                    </div>

                                    <h6 class="fw-bold mb-1">
                                        <a asp-page="Details" asp-route-id="@listing.ListingId"
                                           class="text-decoration-none text-dark stretched-link">@listing.Title</a>
                                    </h6>
                                    <p class="text-muted small mb-3">@listing.ItemName</p>

                                    <div class="d-flex justify-content-between text-muted small mb-3">
                                        <span><i class="bi bi-eye me-1"></i>@listing.ViewCount views</span>
                                        <span>
                                            @if (listing.AskingPrice.HasValue)
                                            {
                                                <strong class="text-dark">$@listing.AskingPrice.Value.ToString("N2")</strong>
                                            }
                                            else
                                            {
                                                <span>Trade only</span>
                                            }
                                        </span>
                                    </div>

                                    @if (listing.PendingOffers > 0)
                                    {
                                        <div class="alert alert-warning py-1 px-2 mb-2 rounded-2 small mb-2"
                                             style="background:#fef9c3;border:none;">
                                            <i class="bi bi-bell-fill me-1"></i>
                                            <strong>@listing.PendingOffers</strong> pending offer@(listing.PendingOffers > 1 ? "s" : "")
                                        </div>
                                    }

                                    <div class="d-flex justify-content-between align-items-center mt-auto pt-2 border-top">
                                        <span class="text-muted" style="font-size:.72rem;">
                                            <i class="bi bi-calendar3 me-1"></i>@listing.ListedDate.ToString("MMM dd, yyyy")
                                        </span>
                                        @if (listing.Status == "Active")
                                        {
                                            <form method="post" asp-page-handler="CancelListing" class="d-inline">
                                                <input type="hidden" name="listingId" value="@listing.ListingId" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-2 py-0"
                                                        style="font-size:.75rem; position:relative; z-index:2;"
                                                        onclick="return confirm('Cancel this listing?');">
                                                    <i class="bi bi-x-circle me-1"></i>Cancel
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    @* Received Offers *@
    <div class="card border-0 rounded-4 shadow-sm mb-4">
        <div class="card-header bg-white border-bottom rounded-top-4 px-4 py-3">
            <h5 class="mb-0 fw-semibold">
                <i class="bi bi-envelope-open me-2 text-warning"></i>Offers Received
                @if (pendingOffers.Count > 0)
                {
                    <span class="badge bg-warning text-dark ms-1">@pendingOffers.Count pending</span>
                }
            </h5>
        </div>
        <div class="card-body p-0">
            @if (!Model.ReceivedOffers.Any())
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-inbox" style="font-size:2.5rem; color:#cbd5e1;"></i>
                    <p class="mt-3">No offers received yet.</p>
                </div>
            }
            else
            {
                @foreach (var offer in Model.ReceivedOffers.OrderByDescending(o => o.OfferedDate))
                {
                    var offerBg  = offer.Status == "Pending" ? "#fffbeb" : "#fff";
                    var offerBorder = offer.Status == "Pending" ? "#fde68a" : "#f1f5f9";
                    <div class="offer-row px-4 py-3 d-flex flex-wrap align-items-center gap-3"
                         style="background:@offerBg; border-bottom:1px solid @offerBorder;">

                        @* Buyer avatar *@
                        <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold text-white flex-shrink-0"
                             style="width:42px;height:42px;background:#6366f1;font-size:.9rem;">
                            @offer.BuyerUserName.Substring(0,1).ToUpper()
                        </div>

                        @* Main info *@
                        <div class="flex-grow-1" style="min-width:160px;">
                            <div class="fw-semibold small">@offer.BuyerUserName</div>
                            <div class="text-muted" style="font-size:.78rem;">
                                <a asp-page="Details" asp-route-id="@offer.ListingId"
                                   class="text-decoration-none text-muted">@offer.ListingTitle</a>
                            </div>
                            @if (!string.IsNullOrEmpty(offer.Message))
                            {
                                <div class="text-muted mt-1" style="font-size:.75rem; font-style:italic;">
                                    "@offer.Message"
                                </div>
                            }
                        </div>

                        @* Price / type *@
                        <div class="text-center flex-shrink-0" style="min-width:80px;">
                            @if (offer.OfferedPrice.HasValue)
                            {
                                <div class="fw-bold text-dark">$@offer.OfferedPrice.Value.ToString("N2")</div>
                            }
                            <span class="badge bg-secondary rounded-pill small">@offer.OfferType</span>
                            <div class="text-muted mt-1" style="font-size:.72rem;">Qty: @offer.QuantityRequested</div>
                        </div>

                        @* Status *@
                        <div class="flex-shrink-0" style="min-width:90px;">
                            @{
                                var (badgeClass, dotBg) = offer.Status switch {
                                    "Pending"        => ("warning text-dark", "#f59e0b"),
                                    "Accepted"       => ("success",           "#16a34a"),
                                    "Rejected"       => ("danger",            "#dc2626"),
                                    "AwaitingPayment"=> ("info",              "#0891b2"),
                                    _                => ("secondary",         "#94a3b8")
                                };
                            }
                            <span class="badge bg-@badgeClass rounded-pill">
                                <span class="status-dot" style="background:#fff; opacity:.8;"></span>@offer.Status
                            </span>
                            <div class="text-muted mt-1" style="font-size:.72rem;">
                                @offer.OfferedDate.ToString("MMM dd, yyyy")
                            </div>
                        </div>

                        @* Actions *@
                        <div class="flex-shrink-0">
                            @if (offer.Status == "Pending")
                            {
                                <button type="button" class="btn btn-sm btn-success rounded-pill me-1"
                                        data-bs-toggle="modal"
                                        data-bs-target="#acceptModal@(offer.OfferId.ToString())">
                                    <i class="bi bi-check-lg"></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-danger rounded-pill"
                                        data-bs-toggle="modal"
                                        data-bs-target="#rejectModal@(offer.OfferId.ToString())">
                                    <i class="bi bi-x-lg"></i>
                                </button>
                            }
                        </div>
                    </div>

                    @if (offer.Status == "Pending")
                    {
                        @* Accept Modal *@
                        <div class="modal fade" id="acceptModal@(offer.OfferId)" tabindex="-1">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content border-0 rounded-4 shadow-lg">
                                    <div class="modal-header border-0 pb-0">
                                        <div class="rounded-circle bg-success bg-opacity-10 p-2 me-2">
                                            <i class="bi bi-check-circle-fill text-success fs-5"></i>
                                        </div>
                                        <h5 class="modal-title fw-bold">Accept Offer</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                    </div>
                                    <form method="post" asp-page-handler="AcceptOffer">
                                        <div class="modal-body pt-2">
                                            <input type="hidden" name="offerId" value="@offer.OfferId" />
                                            <p class="text-muted small mb-3">
                                                Accept offer from <strong>@offer.BuyerUserName</strong>
                                                @if (offer.OfferedPrice.HasValue)
                                                {
                                                    <text> for <strong>$@offer.OfferedPrice.Value.ToString("N2")</strong></text>
                                                }
                                                ? The item will be transferred immediately if the buyer has sufficient funds.
                                            </p>
                                            <div class="mb-3">
                                                <label class="form-label small fw-semibold">Message (optional)</label>
                                                <textarea name="response" class="form-control rounded-3" rows="2"
                                                          placeholder="Thank you! Enjoy your item!"></textarea>
                                            </div>
                                        </div>
                                        <div class="modal-footer border-0 pt-0">
                                            <button type="button" class="btn btn-light rounded-pill" data-bs-dismiss="modal">Cancel</button>
                                            <button type="submit" class="btn btn-success rounded-pill px-4">
                                                <i class="bi bi-check-lg me-1"></i>Confirm Accept
                                            </button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>

                        @* Reject Modal *@
                        <div class="modal fade" id="rejectModal@(offer.OfferId)" tabindex="-1">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content border-0 rounded-4 shadow-lg">
                                    <div class="modal-header border-0 pb-0">
                                        <div class="rounded-circle bg-danger bg-opacity-10 p-2 me-2">
                                            <i class="bi bi-x-circle-fill text-danger fs-5"></i>
                                        </div>
                                        <h5 class="modal-title fw-bold">Reject Offer</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                    </div>
                                    <form method="post" asp-page-handler="RejectOffer">
                                        <div class="modal-body pt-2">
                                            <input type="hidden" name="offerId" value="@offer.OfferId" />
                                            <p class="text-muted small mb-3">
                                                Reject the offer from <strong>@offer.BuyerUserName</strong>?
                                                They will be notified.
                                            </p>
                                            <div class="mb-3">
                                                <label class="form-label small fw-semibold">Reason (optional)</label>
                                                <textarea name="response" class="form-control rounded-3" rows="2"
                                                          placeholder="Sorry, looking for a better offer."></textarea>
                                            </div>
                                        </div>
                                        <div class="modal-footer border-0 pt-0">
                                            <button type="button" class="btn btn-light rounded-pill" data-bs-dismiss="modal">Cancel</button>
                                            <button type="submit" class="btn btn-danger rounded-pill px-4">
                                                <i class="bi bi-x-lg me-1"></i>Confirm Reject
                                            </button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    }
                }
            }
        </div>
    </div>

</div>
