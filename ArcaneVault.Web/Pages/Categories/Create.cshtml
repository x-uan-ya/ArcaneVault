@page
@model ArcaneVault.Web.Pages.Categories.CreateModel
@{
    ViewData["Title"] = "New Category";
}

<h2 class="mb-3">New Category</h2>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<div class="row">
    <div class="col-md-6">
        <form method="post">
            <div class="mb-3">
                <label asp-for="Input.CategoryCode" class="form-label"></label>
                <input asp-for="Input.CategoryCode" class="form-control" />
                <span asp-validation-for="Input.CategoryCode" class="text-danger"></span>
                <div class="form-text">Short code, e.g. MTGCRD, ANIME</div>
            </div>
            <div class="mb-3">
                <label asp-for="Input.CategoryName" class="form-label"></label>
                <input asp-for="Input.CategoryName" class="form-control" />
                <span asp-validation-for="Input.CategoryName" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-success">Create</button>
            <a asp-page="Index" class="btn btn-secondary ms-2">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
